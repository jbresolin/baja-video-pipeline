// Tailnet policy for the Baja tailnet (shared: Baja platform prod + staging,
// Uptime Kuma monitor, João's devices, AND the video pipeline's workers).
//
// This is the COMPLETE policy file: admin console → Access controls → paste
// → Save. It is the existing policy of 2026-11-03 plus the video-pipeline
// section (LIVESTACK-29). See infra/tailnet/README.md.
//
// How isolation works here
// ------------------------
// The "allow all" rule below is autogroup:member → autogroup:member. Tagged
// devices are NOT members, so a tag:worker / tag:studio node gets nothing
// from that rule in either direction: it cannot reach prod, staging or the
// monitor, and they cannot reach it, except through the explicit grants in
// the "Video pipeline" block. Prod and staging stay ordinary member devices;
// nothing about them changes.
//
// Pipeline ports (the contract every component adopts)
//   8080  Caddy on the staging VPS, tailnet-side listener: worker/studio API
//         and inbox/outbox files. Published on the VPS's Tailscale IP only.
//   8081  Evolution Manager/API, tailnet-side, admins only.
//   8710  worker file server (peer raw fetches between workers)
//   8720  studio receiver (finished clips pushed to the streaming PC)
//   8700  worker setup page — localhost only, never on the tailnet.
//
// https://tailscale.com/kb/1337/policy-syntax
{
	// Who may apply each tag to a device. https://tailscale.com/kb/1068/tags
	"tagOwners": {
		// Uptime Kuma probe on the TrueNAS (pre-existing).
		"tag:monitor": ["autogroup:admin"],

		// --- Video pipeline ---------------------------------------------
		// Volunteers' PCs and the master desktop. Keys are minted by the
		// orchestrator's OAuth client, which carries tag:enroller.
		"tag:worker": ["autogroup:admin", "tag:enroller"],

		// The streaming PC (worker app in studio role).
		"tag:studio": ["autogroup:admin", "tag:enroller"],

		// Never applied to a device. It exists only so the orchestrator's
		// OAuth client can mint keys for tag:worker OR tag:studio: a key
		// minted by an OAuth client must carry exactly the client's tags, or
		// tags owned by the client's tags.
		// https://tailscale.com/kb/1623/trust-credentials
		"tag:enroller": ["autogroup:admin"],
	},

	"hosts": {
		"baja-origin":  "100.124.2.82", // VM AWS
		"baja-prod":    "100.124.2.82",
		"baja-staging": "100.82.21.71", // also hosts the video pipeline's VPS stacks
	},

	// https://tailscale.com/kb/1538/grants-syntax
	"grants": [
		// Allow all connections between members' own devices (pre-existing).
		// Tagged devices are not members: this rule never includes workers.
		{"src": ["autogroup:member"], "dst": ["autogroup:member"], "ip": ["*"]},

		// Monitoring probe -> origin HTTPS only (pre-existing).
		{"src": ["tag:monitor"], "dst": ["baja-origin"], "ip": ["tcp:443"]},

		// Monitoring probe -> Evolution's tailnet listener on the staging VPS,
		// so Uptime Kuma can send WhatsApp alerts through the Baja Bot
		// (notification type "Evolution", URL http://100.82.21.71:8081).
		// 8081 only: not the pipeline's 8080, not SSH.
		{"src": ["tag:monitor"], "dst": ["baja-staging"], "ip": ["tcp:8081"]},

		// --- Video pipeline ---------------------------------------------
		// Workers → staging VPS: orchestrator API and inbox/outbox files,
		// through Caddy's tailnet-side listener on 8080. Nothing else on
		// the VPS (no SSH, no 443, no Evolution).
		{"src": ["tag:worker"], "dst": ["baja-staging"], "ip": ["tcp:8080"]},

		// Workers ↔ workers: peer raw fetches from each other's file server.
		{"src": ["tag:worker"], "dst": ["tag:worker"], "ip": ["tcp:8710"]},

		// Workers → studio: push finished clips to the streaming PC.
		{"src": ["tag:worker"], "dst": ["tag:studio"], "ip": ["tcp:8720"]},

		// Studio → staging VPS: heartbeats, clip manifest, ACKs and the
		// outbox fallback pull, through Caddy on 8080.
		{"src": ["tag:studio"], "dst": ["baja-staging"], "ip": ["tcp:8080"]},

		// Intentionally absent: any grant with src baja-staging or baja-prod
		// towards workers. The VPS never opens connections to workers or the
		// studio; everything it serves is pulled from it.
		//
		// Also intentionally absent: an "autogroup:admin → tag:worker" grant
		// for troubleshooting. Both VPSs are owned by an admin account, so
		// such a grant would match them too and break the rule above (the
		// policy tests caught exactly that). If you need to reach a worker's
		// file server from your own laptop during an event, add a grant
		// scoped to that one device, e.g.
		//   {"src": ["<your-laptop-tailscale-ip>"], "dst": ["tag:worker"], "ip": ["tcp:8710"]},
		// and remove it afterwards.
	],

	// Tailscale SSH (pre-existing): members into their own devices, check mode.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Checked every time the policy is saved; the console refuses a policy
	// whose tests fail. https://tailscale.com/kb/1337/policy-syntax
	"tests": [
		// --- Pre-existing -----------------------------------------------
		{"src": "baja-prod", "accept": ["baja-staging:22"]},
		{"src": "baja-staging", "accept": ["baja-prod:22"]},
		{
			"src":    "tag:monitor",
			"accept": ["baja-origin:443", "baja-staging:8081"],
			"deny":   ["baja-prod:22", "baja-staging:22", "baja-staging:8080"],
		},

		// --- Video pipeline ---------------------------------------------
		// A worker reaches exactly what it needs...
		{
			"src":    "tag:worker",
			"proto":  "tcp",
			"accept": ["baja-staging:8080", "tag:worker:8710", "tag:studio:8720"],
			// ...and nothing else: never prod, never the monitor, nothing on
			// the VPS but 8080, no studio-only port on peers.
			"deny": [
				"baja-prod:22", "baja-prod:443", "baja-prod:80",
				"baja-staging:22", "baja-staging:443", "baja-staging:8081", "baja-staging:8000",
				"tag:monitor:3001", "tag:monitor:22",
				"tag:worker:8720", "tag:studio:8710", "tag:worker:22",
			],
		},

		// The studio talks only to the VPS on 8080; never into workers or prod.
		{
			"src":    "tag:studio",
			"proto":  "tcp",
			"accept": ["baja-staging:8080"],
			"deny":   ["baja-staging:22", "baja-staging:8081", "baja-prod:22", "baja-prod:443", "tag:worker:8710", "tag:worker:8720"],
		},

		// The VPS and prod initiate nothing towards workers or the studio.
		{"src": "baja-staging", "proto": "tcp", "deny": ["tag:worker:8710", "tag:studio:8720", "tag:worker:22"]},
		{"src": "baja-prod",    "proto": "tcp", "deny": ["tag:worker:8710", "tag:studio:8720", "tag:worker:22"]},

		// The monitor cannot see the pipeline either.
		{"src": "tag:monitor", "proto": "tcp", "deny": ["baja-staging:8080", "tag:worker:8710", "tag:studio:8720"]},
	],
}
