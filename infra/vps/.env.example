# Pipeline stack — environment for infra/vps/docker-compose.yml, up.sh,
# down.sh and compose-smoke.sh.
# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
#
# Quoting: wrap any value containing `$` or spaces in SINGLE quotes. Docker
# Compose treats single-quoted values literally, and the scripts load this
# file into bash (`set -a; . ./.env; set +a`).
# Secrets: generate with `openssl rand -hex 24`.
#
# Evolution, Postgres, Redis and the public Caddy are the BASE stack's
# (jbresolin/baja-vps); their settings live in that repo's .env, not here.
# Reviewer logins are NOT here either. They live in
# /srv/pipeline/reviewers.txt (README §4), shared by the base Caddy and the
# orchestrator.

# -----------------------------------------------------------------------------
# Hostnames and addresses
# -----------------------------------------------------------------------------
# Public hostname for the review UI, proxies, thumbs and /enroll (DNS A/AAAA
# -> VPS). up.sh writes it into the base Caddy's conf.d/pipeline.caddy.
PIPELINE_DOMAIN=review.example.org
# The VPS's Tailscale IPv4 (`tailscale ip -4`). pipeline-edge's tailnet
# listener is published ONLY on this address, port 8080.
# BVP_TAILNET_BASE_URL is built from it.
TAILSCALE_IP=100.64.0.1
# Where the BASE Caddy container sees /srv/pipeline (its read-only bind
# mount, README §1). up.sh writes it into conf.d/pipeline.caddy (file_server
# root and the reviewers.txt import). Leave the default unless the base
# stack mounts it elsewhere.
CADDY_PIPELINE_DIR=/srv/pipeline
# Evolution's base URL as seen FROM THE VPS HOST, for up.sh, down.sh and the
# smoke test (webhook on/off, connection state). Normally the base stack's
# public Evolution hostname.
EVOLUTION_URL=https://evo.example.org

# -----------------------------------------------------------------------------
# Images (README §5: private on ghcr.io unless you made them public)
# -----------------------------------------------------------------------------
# Built by .github/workflows/images.yml: tags `main`, the short commit SHA,
# and release tags v*. Pin a SHA or v* tag for an event.
ORCHESTRATOR_IMAGE=ghcr.io/jbresolin/baja-orchestrator:main
REVIEW_UI_IMAGE=ghcr.io/jbresolin/baja-review-ui:main

# -----------------------------------------------------------------------------
# Orchestrator (BVP_*, design §15). Fixed values (BVP_DATA_DIR=/srv/pipeline,
# BVP_REVIEWERS_FILE, BVP_EVOLUTION_URL=http://evolution:8080,
# BVP_PUBLIC_BASE_URL=https://$PIPELINE_DOMAIN,
# BVP_TAILNET_BASE_URL=http://$TAILSCALE_IP:8080) are set in docker-compose.yml.
# -----------------------------------------------------------------------------
# Evolution instance name of the Baja Bot account (the base stack's runbook
# records it).
BVP_EVOLUTION_INSTANCE=REPLACE_WITH_INSTANCE_NAME
# Instance token of that instance ("token" column of "Instance"). Used as
# the `apikey` for bot replies (sendText), and by up.sh/down.sh to set the
# instance webhook. Scoped to one instance, so the base stack's global
# Evolution key never has to be here. Canonical name (design §17); the
# orchestrator still accepts the old name BVP_EVOLUTION_INSTANCE_TOKEN.
BVP_EVOLUTION_API_KEY=REPLACE_ME
# Shared secret. up.sh configures Evolution to send it as the
# `X-Webhook-Secret` header on the instance webhook (README §8), and the
# orchestrator rejects calls without it.
BVP_WEBHOOK_SECRET=REPLACE_ME_HEX
# Bearer token for admin endpoints (e.g. POST /admin/enrollment-tokens, /metrics).
BVP_ADMIN_TOKEN=REPLACE_ME_HEX
# Peers whose X-Forwarded-For the orchestrator believes for the /enroll rate
# limit (README §9): localhost, baja-edge (10.201.0.0/24, set by the base
# stack; the base Caddy reaches the orchestrator from there) and this
# stack's own `pipeline` network (10.202.0.0/24, pinned in
# docker-compose.yml; pipeline-edge). compose-smoke.sh checks that every
# baja-edge subnet is covered.
BVP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.201.0.0/24,10.202.0.0/24
# Disk caps (design §10/§15, README §10).
# Above this the bot tells senders to hold (soft, enforced by the orchestrator).
BVP_INBOX_HOLD_GB=22
# Hard cap. Also the size of the inbox loop filesystem (README §2.3), so the
# kernel enforces it too.
BVP_INBOX_CAP_GB=25
# Evict oldest completed proxies when the root filesystem has less free space than this.
BVP_PROXY_EVICT_MIN_FREE_GB=10

# Team names for the review form (design §17). Both optional: the CSV is
# asked first (car_number,team_name,school; edits are picked up without a
# restart), then the Baja app. Unknown cars simply have no team name.
BVP_TEAMS_FILE=/srv/pipeline/teams.csv
# Baja app base URL (GET /api/teams/{car}). Leave empty until confirmed.
BVP_BAJA_APP_URL=

# Tailscale API for enrollment key minting (infra/tailnet/mint_auth_key.md):
# OAuth client tagged tag:enroller with the auth-keys scope.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# `-` = the tailnet that owns the OAuth client.
TAILSCALE_TAILNET=-
# Only tests change this. They point it at a fake server.
TAILSCALE_API_BASE=https://api.tailscale.com
