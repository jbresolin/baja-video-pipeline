# Baja staging VPS — environment for infra/vps/docker-compose.yml.
# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
#
# Quoting: wrap any value containing `$` (bcrypt hashes) or spaces in SINGLE
# quotes. Docker Compose treats single-quoted values literally, and the
# runbook also loads this file into bash (`set -a; . ./.env; set +a`).
# Secrets: generate with `openssl rand -hex 24` (hex = URL-safe, so it can
# go straight into DATABASE_CONNECTION_URI).
#
# Values marked [MATCH TRUENAS] must be copied from the running TrueNAS
# Evolution container (README §1.2). Any other value breaks the migrated session.

# -----------------------------------------------------------------------------
# Hostnames and TLS (Caddy)
# -----------------------------------------------------------------------------
# Public hostname for the Evolution API + Manager UI (DNS A/AAAA -> VPS).
EVO_DOMAIN=evo.example.org
# Public hostname for the review UI and proxies (DNS A/AAAA -> VPS).
PIPELINE_DOMAIN=review.example.org
# Let's Encrypt account e-mail.
ACME_EMAIL=you@example.org
# The VPS's Tailscale IPv4 (`tailscale ip -4`). The worker API is published
# ONLY on this address, port 8080.
TAILSCALE_IP=100.64.0.1

# Manager UI basic auth (in front of Evolution's own API-key login).
# Hash: docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext 'the-password'
MANAGER_BASIC_AUTH_USER=baja
MANAGER_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT'

# Review UI + /proxies/* basic auth (shared reviewer login). Same hashing command.
REVIEW_BASIC_AUTH_USER=revisor
REVIEW_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT'

# -----------------------------------------------------------------------------
# Evolution API
# -----------------------------------------------------------------------------
# Global API key (header `apikey`). [MATCH TRUENAS] for the cutover, so
# n8n's credentials keep working. Rotate later if you like (README §7).
EVOLUTION_API_KEY=REPLACE_ME
# Instance name of the Baja Bot instance, exactly as on TrueNAS.
EVOLUTION_INSTANCE_NAME=BajaBot
# [MATCH TRUENAS] DATABASE_CONNECTION_CLIENT_NAME. Instances whose
# "clientName" differs are silently NOT loaded.
EVOLUTION_CLIENT_NAME=evolution_exchange
# [MATCH TRUENAS] the `?schema=` part of TrueNAS's DATABASE_CONNECTION_URI
# (upstream example: evolution_api, some installs use public).
EVOLUTION_DB_SCHEMA=evolution_api
# [MATCH TRUENAS] the DB index at the end of CACHE_REDIS_URI (redis://host:6379/<N>).
EVOLUTION_REDIS_DB=6
# [MATCH TRUENAS] CACHE_REDIS_PREFIX_KEY (code default is `evolution-cache`
# if unset, the upstream .env.example sets `evolution`).
EVOLUTION_REDIS_PREFIX=evolution
# [MATCH TRUENAS] CACHE_REDIS_SAVE_INSTANCES (default false).
EVOLUTION_REDIS_SAVE_INSTANCES=false
# Shown on the phone under Linked devices. Keep the TrueNAS values.
EVOLUTION_PHONE_CLIENT='Evolution API'
EVOLUTION_PHONE_NAME=Chrome
# What Evolution stores in Postgres. Copy TrueNAS's values if BajaBot reads
# stored chats/messages through the API, otherwise these defaults are fine.
EVOLUTION_SAVE_NEW_MESSAGE=true
EVOLUTION_SAVE_MESSAGE_UPDATE=false
EVOLUTION_SAVE_CONTACTS=true
EVOLUTION_SAVE_CHATS=true
EVOLUTION_SAVE_LABELS=false
EVOLUTION_SAVE_HISTORIC=false

# Postgres for Evolution. A new password is fine. The dump restores data,
# not roles. DB name/user can differ from TrueNAS (restore uses --no-owner).
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=REPLACE_ME_HEX

# -----------------------------------------------------------------------------
# Webhooks (README §6)
#   instance webhook -> orchestrator (stored in Postgres, set via API, not here)
#   global webhook   -> n8n / BajaBot (configured here, phase B)
# -----------------------------------------------------------------------------
# Phase A (migration day): false. The instance webhook keeps pointing at n8n as today.
# Phase B (orchestrator live): true, and the instance webhook moves to the orchestrator.
N8N_GLOBAL_WEBHOOK_ENABLED=false
# n8n Webhook-node URL, reachable FROM THE VPS (README §1.5). The global
# webhook cannot send custom headers, so the secret must be in the path.
N8N_WEBHOOK_URL=https://n8n.example.org/webhook/REPLACE_WITH_BAJABOT_PATH
# Copy `webhookByEvents` from TrueNAS's current webhook (README §1.4).
N8N_WEBHOOK_BY_EVENTS=false
# Events sent to n8n via the global webhook. Set true exactly the events in
# TrueNAS's current webhook "events" list (README §1.4). Unlisted = false.
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=false
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_MESSAGES_UPDATE=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CALL=false
# Also accepted (default false): APPLICATION_STARTUP, MESSAGES_SET,
# MESSAGES_EDITED, MESSAGES_DELETE, SEND_MESSAGE_UPDATE, CONTACTS_SET,
# CONTACTS_UPDATE, PRESENCE_UPDATE, CHATS_SET, CHATS_UPDATE, CHATS_DELETE,
# GROUPS_UPSERT, GROUPS_UPDATE, GROUP_PARTICIPANTS_UPDATE, LABELS_EDIT,
# LABELS_ASSOCIATION, REMOVE_INSTANCE, LOGOUT_INSTANCE, each as WEBHOOK_EVENTS_<NAME>.

# -----------------------------------------------------------------------------
# Orchestrator (stub, LIVESTACK-24). The orchestrator PR owns the final
# names. These are what the compose stub passes in today.
# -----------------------------------------------------------------------------
# Image to run. Until set, the service sits behind the `orchestrator` profile.
ORCHESTRATOR_IMAGE=ghcr.io/jbresolin/baja-orchestrator:CHANGE-ME
# Instance token of the Baja Bot instance ("token" column of "Instance"),
# used to send bot replies. Scoped to one instance, unlike EVOLUTION_API_KEY.
EVOLUTION_INSTANCE_TOKEN=REPLACE_ME
# Shared secret Evolution sends as a header on the instance webhook
# (`x-webhook-secret`, README §6.2). The orchestrator rejects calls without it.
EVOLUTION_WEBHOOK_SECRET=REPLACE_ME_HEX
# Disk caps (design §10, README §8).
# Hard cap of the inbox filesystem (kernel-enforced by the 25 GiB loop fs).
INBOX_CAP_GB=25
# Above this the bot tells senders to hold (soft cap, enforced by the orchestrator).
INBOX_HOLD_GB=22
# Evict oldest completed proxies when the root filesystem has less free space than this.
PROXY_EVICT_MIN_FREE_GB=10
# Tailscale API (enrollment, design §8, LIVESTACK-29): OAuth client with the auth-keys scope.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_TAILNET=
