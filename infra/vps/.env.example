# Baja staging VPS — environment for infra/vps/docker-compose.yml.
# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
#
# Quoting: wrap any value containing `$` (bcrypt hashes) or spaces in SINGLE
# quotes. Docker Compose treats single-quoted values literally, and the
# runbook also loads this file into bash (`set -a; . ./.env; set +a`).
# Secrets: generate with `openssl rand -hex 24` (hex = URL-safe, so it can
# go straight into DATABASE_CONNECTION_URI).
#
# Values marked [MATCH TRUENAS] must be copied from the running TrueNAS
# Evolution container (README §1.2). Any other value breaks the migrated session.
#
# Reviewer logins are NOT here. They live in /srv/pipeline/reviewers.htpasswd
# (README §2.6), shared by Caddy and the orchestrator.

# -----------------------------------------------------------------------------
# Hostnames and TLS (Caddy)
# -----------------------------------------------------------------------------
# Public hostname for the Evolution API + Manager UI (DNS A/AAAA -> VPS).
EVO_DOMAIN=evo.example.org
# Public hostname for the review UI, proxies, thumbs and /enroll (DNS A/AAAA -> VPS).
PIPELINE_DOMAIN=review.example.org
# Let's Encrypt account e-mail.
ACME_EMAIL=you@example.org
# The VPS's Tailscale IPv4 (`tailscale ip -4`). Caddy's tailnet listener is
# published ONLY on this address, port 8080. BVP_TAILNET_BASE_URL is built from it.
TAILSCALE_IP=100.64.0.1

# Manager UI basic auth (in front of Evolution's own API-key login).
# Hash: docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext 'the-password'
MANAGER_BASIC_AUTH_USER=baja
MANAGER_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT'

# -----------------------------------------------------------------------------
# Evolution API
# -----------------------------------------------------------------------------
# Global API key (header `apikey`). [MATCH TRUENAS] for the cutover, so
# nothing that already holds it breaks. Rotate later if you like (README §7).
EVOLUTION_API_KEY=REPLACE_ME
# [MATCH TRUENAS] DATABASE_CONNECTION_CLIENT_NAME. Instances whose
# "clientName" differs are silently NOT loaded.
EVOLUTION_CLIENT_NAME=evolution_exchange
# [MATCH TRUENAS] the `?schema=` part of TrueNAS's DATABASE_CONNECTION_URI
# (upstream example: evolution_api, some installs use public).
EVOLUTION_DB_SCHEMA=evolution_api
# [MATCH TRUENAS] the DB index at the end of CACHE_REDIS_URI (redis://host:6379/<N>).
EVOLUTION_REDIS_DB=6
# [MATCH TRUENAS] CACHE_REDIS_PREFIX_KEY (code default is `evolution-cache`
# if unset, the upstream .env.example sets `evolution`).
EVOLUTION_REDIS_PREFIX=evolution
# [MATCH TRUENAS] CACHE_REDIS_SAVE_INSTANCES (default false).
EVOLUTION_REDIS_SAVE_INSTANCES=false
# Shown on the phone under Linked devices. Keep the TrueNAS values.
EVOLUTION_PHONE_CLIENT='Evolution API'
EVOLUTION_PHONE_NAME=Chrome
# What Evolution stores in Postgres. The pipeline reads nothing back from
# it, so these modest defaults are fine.
EVOLUTION_SAVE_NEW_MESSAGE=true
EVOLUTION_SAVE_MESSAGE_UPDATE=false
EVOLUTION_SAVE_CONTACTS=true
EVOLUTION_SAVE_CHATS=true
EVOLUTION_SAVE_LABELS=false
EVOLUTION_SAVE_HISTORIC=false

# Postgres for Evolution. A new password is fine. The dump restores data,
# not roles. DB name/user can differ from TrueNAS (restore uses --no-owner).
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=REPLACE_ME_HEX

# -----------------------------------------------------------------------------
# Orchestrator (BVP_*, design §15). Fixed values (BVP_DATA_DIR=/srv/pipeline,
# BVP_REVIEWERS_FILE, BVP_EVOLUTION_URL=http://evolution:8080,
# BVP_PUBLIC_BASE_URL=https://$PIPELINE_DOMAIN,
# BVP_TAILNET_BASE_URL=http://$TAILSCALE_IP:8080) are set in docker-compose.yml.
# -----------------------------------------------------------------------------
# Image to run. Until set, the service sits behind the `orchestrator` profile.
ORCHESTRATOR_IMAGE=ghcr.io/jbresolin/baja-orchestrator:CHANGE-ME
# Evolution instance name of the Baja Bot account, exactly as on TrueNAS (README §1.4).
BVP_EVOLUTION_INSTANCE=REPLACE_WITH_TRUENAS_INSTANCE_NAME
# Instance token of that instance ("token" column of "Instance", README §1.4),
# used for bot replies (sendText). Scoped to one instance, unlike EVOLUTION_API_KEY.
BVP_EVOLUTION_INSTANCE_TOKEN=REPLACE_ME
# Shared secret. Evolution sends it as the `X-Webhook-Secret` header on the
# instance webhook (README §6.2), and the orchestrator rejects calls without it.
BVP_WEBHOOK_SECRET=REPLACE_ME_HEX
# Bearer token for admin endpoints (e.g. POST /admin/enrollment-tokens).
BVP_ADMIN_TOKEN=REPLACE_ME_HEX
# Disk caps (design §10/§15, README §8.2).
# Above this the bot tells senders to hold (soft, enforced by the orchestrator).
BVP_INBOX_HOLD_GB=22
# Hard cap. Also the size of the inbox loop filesystem (README §2.3), so the
# kernel enforces it too.
BVP_INBOX_CAP_GB=25
# Evict oldest completed proxies when the root filesystem has less free space than this.
BVP_PROXY_EVICT_MIN_FREE_GB=10

# Tailscale API for enrollment key minting (infra/tailnet/mint_auth_key.md):
# OAuth client tagged tag:enroller with the auth-keys scope.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# `-` = the tailnet that owns the OAuth client.
TAILSCALE_TAILNET=-
# Only tests change this. They point it at a fake server.
TAILSCALE_API_BASE=https://api.tailscale.com
