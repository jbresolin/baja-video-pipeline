# Public routes of the video pipeline (design §8, §20), for the BASE stack's
# Caddy (repo jbresolin/baja-vps), which imports /srv/caddy/conf.d/*.caddy.
#
# This file is a TEMPLATE. Do not copy it by hand: ./up.sh renders it with
# envsubst, installs it as /srv/caddy/conf.d/pipeline.caddy and reloads the
# base Caddy; ./down.sh removes it again (README §6, §7). Only two
# variables are substituted, both from .env (written here without their
# dollar sign, or envsubst would replace them in this comment too):
#   PIPELINE_DOMAIN     the public hostname (DNS A/AAAA -> VPS)
#   CADDY_PIPELINE_DIR  where the base Caddy container sees /srv/pipeline
#                       (read-only bind mount, README §1; proxies/ and thumbs/)
# They are resolved at install time because the base Caddy's environment
# belongs to the base stack: a Caddy env placeholder here would read the
# base container's variables, which this repo does not set. Caddy
# placeholders such as {http.auth.user.id} are left alone.
#
# DNS: the pipeline hostname is DNS-only at Cloudflare (grey cloud), so the
# base Caddy gets a normal HTTP-01 certificate for it and sees the real client
# as the TCP peer. There is deliberately NO Cloudflare-only matcher here (no
# remote_ip allowlist, no trusted_proxies for Cloudflare): X-Forwarded-For
# to the orchestrator carries the real client, which the /enroll rate limit
# needs (README §7, §9).
#
# Snippet names carry a bvp_ prefix: they share one namespace with the base
# Caddyfile and every other conf.d file.
#
# Upstreams are the pipeline containers' aliases on baja-edge
# (docker-compose.yml): bvp-review-ui:8001 and bvp-orchestrator:8000.
#
# Sign-in (admin page, LIVESTACK-37): Caddy asks for no password any more.
# Users live in the orchestrator's database and sign in on the review UI's
# own /review/login page, which sets the bvp_session cookie. Proxies and
# thumbnails are guarded by forward_auth to the orchestrator's GET
# /auth/media, which checks that cookie (the same pattern as /auth/file on
# the tailnet listener). The orchestrator refreshes a session at most once a
# minute, so the many Range requests of the video player stay cheap.

# Static files from the pipeline data dir, for a signed-in browser only.
# forward_auth sends the browser's own request headers (its Cookie included)
# to GET /auth/media: 2xx serves the file, anything else (401) is the answer.
# file_server answers Range (206). Writers drop in-progress files as
# dot-files and rename them when complete (design §15); dot-files and upload
# staging files are never served.
(bvp_pipeline_files) {
	forward_auth bvp-orchestrator:8000 {
		uri /auth/media
	}
	root * ${CADDY_PIPELINE_DIR}
	file_server {
		hide .* *.part *.part.json
	}
}

${PIPELINE_DOMAIN} {
	log {
		output stdout
		format console
	}

	# Proxies (480p review copies, design §6): /proxies/<job_id>.mp4
	handle /proxies/* {
		header Cache-Control "private, max-age=3600"
		import bvp_pipeline_files
	}

	# Thumbnails (worker-made): /thumbs/<job_id>.jpg
	handle /thumbs/* {
		header Cache-Control "private, max-age=3600"
		import bvp_pipeline_files
	}

	# Finished clips still in the outbox (studio offline, or not yet archived
	# by the master), for the review UI's Download button (LIVESTACK-38):
	# /clip-downloads/<job_id>.mp4 -> outbox/<job_id>.mp4. The same sign-in
	# check as proxies (forward_auth to /auth/media, the bvp_session cookie);
	# not the bvp_pipeline_files snippet, because handle_path serves it from
	# outbox/ under another name. The tailnet listener's /outbox/* (workers,
	# studio, /auth/file) is a different route and stays as it is.
	#
	# Readable names (LIVESTACK-41 item 12): the review UI links to
	# /clip-downloads/<job_id>/enduro-042-p3.mp4. That is rewritten to the
	# outbox file <job_id>.mp4, and the download is named after the last part
	# of the address the browser asked for ({http.request.orig_uri.path.file}),
	# so the saved file says prova, car and passagem. The old
	# /clip-downloads/<job_id>.mp4 still works (named after the job id).
	handle_path /clip-downloads/* {
		header Cache-Control "private, no-store"
		header Content-Disposition "attachment; filename=\"{http.request.orig_uri.path.file}\""
		forward_auth bvp-orchestrator:8000 {
			uri /auth/media
		}
		@bvp_named_clip path_regexp bvp_named_clip ^/([0-9a-f]{32})/[A-Za-z0-9._-]+$
		rewrite @bvp_named_clip /{re.bvp_named_clip.1}.mp4
		root * ${CADDY_PIPELINE_DIR}/outbox
		file_server {
			hide .* *.part *.part.json
		}
	}

	# Originals a reviewer asked for on the job page ("Baixar original",
	# LIVESTACK-41 item 15): /original-downloads/<job_id>/<readable raw name>
	# -> originals/<job_id>.<ext>, the extension taken from the name. Same
	# sign-in check as proxies; saved under the readable name (item 12).
	handle_path /original-downloads/* {
		header Cache-Control "private, no-store"
		header Content-Disposition "attachment; filename=\"{http.request.orig_uri.path.file}\""
		forward_auth bvp-orchestrator:8000 {
			uri /auth/media
		}
		@bvp_named_original path_regexp bvp_named_original ^/([0-9a-f]{32})/[A-Za-z0-9._-]*(\.[a-z0-9]{1,5})$
		rewrite @bvp_named_original /{re.bvp_named_original.1}{re.bvp_named_original.2}
		root * ${CADDY_PIPELINE_DIR}/originals
		file_server {
			hide .* *.part *.part.json
		}
	}

	# Review UI: its own service (design §16), with its own login page. It
	# turns the bvp_session cookie into a bearer token for the orchestrator,
	# which checks it on every call (docs/api.md §2). X-Forwarded-For (set
	# by reverse_proxy) lets the orchestrator rate-limit sign-ins per client.
	handle /review* {
		reverse_proxy bvp-review-ui:8001
	}

	# Enrollment (design §8): a new PC is not on the tailnet yet, so this one
	# orchestrator route is public. There's no basic auth, because the
	# one-time token in the body is the credential. The orchestrator
	# rate-limits per source IP itself, from the X-Forwarded-For Caddy sets,
	# provided BVP_TRUSTED_PROXY_CIDRS covers baja-edge (README §9).
	# POST only, small body. Anything else falls through to the 404.
	@bvp_enroll {
		path /enroll
		method POST
	}
	handle @bvp_enroll {
		request_body {
			max_size 16KB
		}
		reverse_proxy bvp-orchestrator:8000
	}

	# Bare domain -> review UI. The `*` matters: `redir /review/ 302`
	# would read "/review/" as a request matcher and "302" as the target,
	# so a request for "/" matched nothing inside this handle and Caddy
	# answered an empty 200 (what the site did before this change).
	handle / {
		redir * /review/ 302
	}

	# Nothing else is public.
	handle {
		respond "Not found" 404
	}
}
